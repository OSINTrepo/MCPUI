# =============================================================================
# Скопируйте в .env и заполните. `.env` не коммитить (см. .gitignore).
# =============================================================================

# ------------------------------ LibreChat -----------------------------------
# ВАЖНО: значения без inline-комментариев — docker env_file берёт всё после '='
# как значение. Сгенерируйте: openssl rand -hex 32 (для CREDS_IV — hex 16).
# CREDS_KEY  — 32-байтный hex (64 симв.) для шифрования per-user vault
# CREDS_IV   — 16-байтный hex (32 симв.)
# JWT_*      — секреты сессий/refresh
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=
MEILI_MASTER_KEY=

# ------------------------------ LiteLLM-шлюз --------------------------------
# Общий ключ для обращений LibreChat -> LiteLLM. `openssl rand -hex 24`
LITELLM_MASTER_KEY=

# ------------------------------ GigaChat (Sber) -----------------------------
# 1. Кабинет разработчика: https://developers.sber.ru/studio/workspaces → GigaChat API
# 2. Создайте проект, получите «Authorization key» (base64) — вставьте сюда.
# 3. Scope: GIGACHAT_API_PERS (физлица) | GIGACHAT_API_B2B | GIGACHAT_API_CORP
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_B2B

# --------------------- Облачные модели: Claude / GPT (опционально) ----------
# Задайте ключ, чтобы работали пресеты «Claude · OSINT Авто» / «GPT · OSINT Авто»
# и эндпоинт «Cloud» в LibreChat. Пусто — модели просто молчат (ключ не задан).
# Anthropic: https://console.anthropic.com/  → API Keys (sk-ant-...)
ANTHROPIC_API_KEY=
# OpenAI: https://platform.openai.com/api-keys  (sk-...)
OPENAI_API_KEY=
# DeepSeek (китайская модель) — сильный и дешёвый писатель отчётов. Пресет
# «DeepSeek · OSINT Авто» + вариант для ORCHESTRATOR_REPORT_MODEL.
# https://platform.deepseek.com/  → API Keys (sk-...)
DEEPSEEK_API_KEY=

# --------------------- Локальная модель: Ollama ----------------------------
# По умолчанию Ollama идёт В СТЕКЕ (сервис `ollama` в docker-compose.yml) и
# работает сразу — на старте докачивается лёгкая модель qwen2.5:0.5b. Ничего
# ставить на хост не нужно.
OLLAMA_BASE_URL=http://ollama:11434
# Хотите свою Ollama НА ХОСТЕ вместо встроенной — раскомментируйте (на Linux
# host.docker.internal резолвится благодаря extra_hosts у сервиса litellm):
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# --------------------- OSINT Orchestrator (агентный режим) ------------------
# Модель, которой оркестратор пользуется для нечёткого подбора серверов и сборки
# отчёта (через LiteLLM). По умолчанию GigaChat-2-Pro; можно указать сильнее
# (напр. claude-opus-4-8, claude-sonnet-5, gpt-4o), если задан их ключ выше.
# Всё деградирует до детерминированных правил, если LLM недоступна.
ORCHESTRATOR_MODEL=GigaChat-2-Pro
# Модель, которая ПИШЕТ отчёт-досье (аналитический синтез). Отделена от подбора
# серверов, чтобы писателя усиливать независимо. Приоритет по замыслу:
# GigaChat сейчас → deepseek-chat → claude-opus-4-8 / gpt-4o (нужен их ключ выше).
# Смена одной строки — без правки кода. Пусто/недоступно → детерминированный отчёт.
ORCHESTRATOR_REPORT_MODEL=GigaChat-2-Pro
# Глубокое досье по домену/IP (веер VirusTotal-связей + RDAP/crt.sh/DNS/GLEIF +
# Censys/WhoisXML при ключах). 1 — включено (похоже на референс-отчёт), 0 — быстрый
# лёгкий режим (shodan+virustotal+rdap).
ORCHESTRATOR_DOMAIN_DEEP=1
# Сколько связей VirusTotal запрашивать в глубоком режиме (resolutions, subdomains,
# historical_ssl_certificates, communicating_files, historical_whois). По умолчанию 5 —
# это заполняет исторические сертификаты, связанные файлы и историю WHOIS, как в
# референс-досье. На free-тарифе VT (~4 req/min) веер разносится по времени; при
# жёстком лимите/без платного ключа опустите до 3, чтобы уложиться быстрее.
ORCHESTRATOR_VT_RELATIONSHIPS=5

# --------------------- Платные источники глубины (опционально) --------------
# Censys Platform (порты/сервисы/сертификаты/reverse-IP). Нужны ОБА значения:
# Personal Access Token и Organization ID. https://platform.censys.io/ → Settings.
# Обёрнуты внутри сервера directapi (hosted-MCP Censys требует 2 заголовка).
CENSYS_PAT=
CENSYS_ORG_ID=
# WhoisXML — историческая регистрация домена (WHOIS History API). 500 бесплатных
# запросов на старте. https://whois-history.whoisxmlapi.com/  Обёрнут в directapi
# (hosted-MCP WhoisXML требует интерактивный OAuth — ключ-в-.env удобнее).
WHOISXML_API_KEY=
# OpenCorporates — должностные лица/директора компании (реестр юрлиц многих стран).
# Карточка с officers требует API-токен: https://opencorporates.com/api_accounts/new
# Обёрнут в directapi. Без ключа officers обычно недоступны (раздел просто опускается).
OPENCORPORATES_API_KEY=

# =============================================================================
# Ключи OSINT MCP-серверов. Имена совпадают с auth.user_var в registry/servers.yaml.
# Free/OSS-серверы работают без ключей; платные — молчат, пока ключ пуст.
# =============================================================================
EXPOSE_TEAM_API_KEY=
XQUIK_API_KEY=
SHODAN_API_KEY=
ZOOMEYE_API_KEY=
CONTRASTAPI_API_KEY=
BRIGHTDATA_API_TOKEN=
ANYSITE_API_KEY=
OPENREGISTRY_API_KEY=
COMPANYSCOPE_API_KEY=
CHECKO_API_KEY=
US_BUSINESS_DATA_API_KEY=
VIRUSTOTAL_API_KEY=

# --- Новые серверы (все работают и без ключа; ключ повышает лимиты) ---
# CrawlGraph: бесплатный ключ приходит на email (crawlgraph.com/docs/api)
CRAWLGRAPH_API_KEY=
# DomScan: keyless работает; ключ (dsk_...) повышает лимиты, уходит в URL
DOMSCAN_API_KEY=
# DataNexus: анонимно работает; ключ (dnx_...) повышает лимиты (заголовок X-DataNexus-Key)
DATANEXUS_API_KEY=
