# =============================================================================
# Скопируйте в .env и заполните. `.env` не коммитить (см. .gitignore).
# =============================================================================

# ------------------------------ LibreChat -----------------------------------
# ВАЖНО: значения без inline-комментариев — docker env_file берёт всё после '='
# как значение. Сгенерируйте: openssl rand -hex 32 (для CREDS_IV — hex 16).
# CREDS_KEY  — 32-байтный hex (64 симв.) для шифрования per-user vault
# CREDS_IV   — 16-байтный hex (32 симв.)
# JWT_*      — секреты сессий/refresh
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=
MEILI_MASTER_KEY=

# ------------------------------ LiteLLM-шлюз --------------------------------
# Общий ключ для обращений LibreChat -> LiteLLM. `openssl rand -hex 24`
LITELLM_MASTER_KEY=

# ------------------------------ GigaChat (Sber) -----------------------------
# 1. Кабинет разработчика: https://developers.sber.ru/studio/workspaces → GigaChat API
# 2. Создайте проект, получите «Authorization key» (base64) — вставьте сюда.
# 3. Scope: GIGACHAT_API_PERS (физлица) | GIGACHAT_API_B2B | GIGACHAT_API_CORP
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_B2B

# --------------------- Облачные модели: Claude / GPT (опционально) ----------
# Задайте ключ, чтобы работали пресеты «Claude · OSINT Авто» / «GPT · OSINT Авто»
# и эндпоинт «Cloud» в LibreChat. Пусто — модели просто молчат (ключ не задан).
# Anthropic: https://console.anthropic.com/  → API Keys (sk-ant-...)
ANTHROPIC_API_KEY=
# OpenAI: https://platform.openai.com/api-keys  (sk-...)
OPENAI_API_KEY=

# --------------------- Локальная модель: Ollama ----------------------------
# По умолчанию Ollama идёт В СТЕКЕ (сервис `ollama` в docker-compose.yml) и
# работает сразу — на старте докачивается лёгкая модель qwen2.5:0.5b. Ничего
# ставить на хост не нужно.
OLLAMA_BASE_URL=http://ollama:11434
# Хотите свою Ollama НА ХОСТЕ вместо встроенной — раскомментируйте (на Linux
# host.docker.internal резолвится благодаря extra_hosts у сервиса litellm):
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# --------------------- OSINT Orchestrator (агентный режим) ------------------
# Модель, которой оркестратор пользуется для нечёткого подбора серверов и сборки
# отчёта (через LiteLLM). По умолчанию GigaChat-2-Pro; можно указать сильнее
# (напр. claude-opus-4-8, claude-sonnet-5, gpt-4o), если задан их ключ выше.
# Всё деградирует до детерминированных правил, если LLM недоступна.
ORCHESTRATOR_MODEL=GigaChat-2-Pro

# =============================================================================
# Ключи OSINT MCP-серверов. Имена совпадают с auth.user_var в registry/servers.yaml.
# Free/OSS-серверы работают без ключей; платные — молчат, пока ключ пуст.
# =============================================================================
EXPOSE_TEAM_API_KEY=
XQUIK_API_KEY=
SHODAN_API_KEY=
ZOOMEYE_API_KEY=
CONTRASTAPI_API_KEY=
BRIGHTDATA_API_TOKEN=
ANYSITE_API_KEY=
OPENREGISTRY_API_KEY=
COMPANYSCOPE_API_KEY=
CHECKO_API_KEY=
US_BUSINESS_DATA_API_KEY=
VIRUSTOTAL_API_KEY=

# --- Новые серверы (все работают и без ключа; ключ повышает лимиты) ---
# CrawlGraph: бесплатный ключ приходит на email (crawlgraph.com/docs/api)
CRAWLGRAPH_API_KEY=
# DomScan: keyless работает; ключ (dsk_...) повышает лимиты, уходит в URL
DOMSCAN_API_KEY=
# DataNexus: анонимно работает; ключ (dnx_...) повышает лимиты (заголовок X-DataNexus-Key)
DATANEXUS_API_KEY=
